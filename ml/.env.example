# PRISM ML API configuration. Copy to .env (never commit .env) or set in the hosting platform's
# secret manager. All values below are PLACEHOLDERS.

# development | production   (production enables HSTS, disables /docs, requires FIREBASE_PROJECT_ID)
PRISM_ENV=development

# Firebase project whose ID tokens the API accepts (public identifier, not a secret)
FIREBASE_PROJECT_ID=your-firebase-project-id

# Server-side service account, ONLY if PRISM_STORAGE_BACKEND=firestore (never in the app or firmware)
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/prism-api-service-account.json

# sqlite (recommended: self-hosted, free, no quota) | firestore (Spark quotas apply) | memory (dev only) | none
PRISM_STORAGE_BACKEND=sqlite
# PRISM_SQLITE_PATH=/srv/prism/prism.sqlite3          (default: ml/data/local_store/prism.sqlite3)

# Per-device HMAC secrets (>= 32 random characters each) and the farm each device belongs to.
# Generate a secret with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
PRISM_DEVICE_SECRETS_JSON={"esp32-pen-1": {"secret": "REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS", "farm_id": "REPLACE_WITH_FARM_ID"}}

# Only needed for browser clients; the Android app does not use CORS. Never use "*".
PRISM_CORS_ORIGINS=

PRISM_MAX_BODY_BYTES=16384
PRISM_RATE_LIMIT_PER_MINUTE=30
PRISM_DEVICE_RATE_LIMIT_PER_MINUTE=20
PRISM_AUTH_FAIL_LIMIT=10
PRISM_AUTH_FAIL_WINDOW_SECONDS=300
PRISM_DEVICE_MAX_SKEW_SECONDS=300
PRISM_ENABLE_DOCS=false

# Model registry location (default: ml/artifacts)
# PRISM_ARTIFACTS_DIR=/srv/prism/artifacts
