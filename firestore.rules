rules_version = '2';

// PRISM Firestore rules.
//
// BEFORE DEPLOYING (otherwise sensor logging stops):
//   1. Firebase console > Authentication > Users > Add user: the ESP32's
//      device account (same email/password as DEVICE_EMAIL / DEVICE_PASSWORD
//      in the ESP32's secrets.h). Copy its User UID.
//   2. Replace REPLACE_WITH_ESP32_DEVICE_UID below with that UID.
//   3. Flash the ESP32 with the firmware that signs in, and check the serial
//      monitor shows "[AUTH] Device signed in to Firebase".
//   4. firebase deploy --only firestore:rules
//
// Cloud Functions and the Python forecast API use the Admin SDK, which
// bypasses these rules, so they are not affected.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function isAdmin() { return signedIn() && request.auth.token.get('role', '') == 'admin'; }
    // The ESP32 signs in with its own Firebase Auth account (see secrets.h).
    function isDevice() { return signedIn() && request.auth.uid == 'REPLACE_WITH_ESP32_DEVICE_UID'; }
    function isUser() { return signedIn() && !isDevice(); }
    function ownsNew() { return isUser() && request.resource.data.userId == uid(); }
    function ownsExisting() { return isUser() && resource.data.userId == uid(); }
    function ownsPig(pigId) {
      return isUser() && get(/databases/$(database)/documents/pigs/$(pigId)).data.userId == uid();
    }
    // getAfter(): the parent may be created in the same transaction (firestore_pig_repo.dart addPig)
    function ownsPigAfter(pigId) {
      return isUser() && getAfter(/databases/$(database)/documents/pigs/$(pigId)).data.userId == uid();
    }
    function ownsMedicine(medId) {
      return isUser() && get(/databases/$(database)/documents/medicines/$(medId)).data.userId == uid();
    }
    function ownsMedicineAfter(medId) {
      return isUser() && getAfter(/databases/$(database)/documents/medicines/$(medId)).data.userId == uid();
    }
    // Limits which keys a write CHANGES (merge-safe: other fields already in the doc are untouched).
    function changesOnly(keys) {
      return resource == null
        ? request.resource.data.keys().hasOnly(keys)
        : request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ---------------- users (the app calls this collection "admins"; it holds EVERY user)
    // Each user can only see and change their own profile (FCM token, thresholds, ...).
    match /admins/{userId} {
      allow read, create, update: if isUser() && userId == uid();
      allow delete: if false;
    }
    match /counters/{userId} {
      allow read, write: if isUser() && userId == uid();
    }

    // ---------------- manual farm records (owner only)
    match /pigs/{pigId} {
      allow read, update, delete: if ownsExisting();
      allow create: if ownsNew();
      match /weight_history/{id}   { allow read: if ownsPig(pigId); allow write: if ownsPigAfter(pigId); }
      match /feeding_records/{id}  { allow read: if ownsPig(pigId); allow write: if ownsPigAfter(pigId); }
      match /medicine_intakes/{id} { allow read: if ownsPig(pigId); allow write: if ownsPigAfter(pigId); }
    }
    // collection-group queries must filter on userId (rules are not filters)
    match /{path=**}/feeding_records/{id}  { allow read: if ownsExisting(); }
    match /{path=**}/medicine_intakes/{id} { allow read: if ownsExisting(); }

    match /medicines/{medId} {
      allow read, update, delete: if ownsExisting();
      allow create: if ownsNew();
      match /medicine_stock/{id} { allow read: if ownsMedicine(medId); allow write: if ownsMedicineAfter(medId); }
    }

    // ---------------- sensor data: only the ESP32 writes, signed-in users read
    // The ESP32 uploads with "update" writes, which are an UPDATE when a retry
    // re-sends a reading that already arrived, so update must be allowed for
    // the device or one lost reply would block the whole backlog.
    match /sensor_readings_seconds/{id} {
      allow read: if signedIn();
      allow create, update: if isDevice();
      allow delete: if false;                   // the TTL policy deletes old readings
    }
    match /sensor_readings_hourly/{id} {
      allow read: if signedIn();
      allow create, update: if isDevice();
      allow delete: if false;
    }
    match /sprinkler_logs/{id} {
      allow read: if signedIn();
      allow create: if isDevice();
      allow update, delete: if false;
    }
    match /live_sensor/{doc} {
      allow read: if signedIn();
      allow write: if isDevice();               // also holds the ESP32's LAN IP the app connects to
    }
    // legacy hourly collections read by lib/core/services/farm_data_service.dart
    match /temperature_hourly/{id} { allow read: if signedIn(); allow write: if isDevice(); }
    match /humidity_hourly/{id}    { allow read: if signedIn(); allow write: if isDevice(); }

    // ---------------- sprinkler control
    match /sprinkler_command/{doc} {
      allow read: if signedIn();
      allow write: if signedIn() && changesOnly(['state']) && request.resource.data.state in ['on', 'off'];
    }
    match /sprinkler_settings/{doc} {
      allow read: if signedIn();
      // the ESP32 clamps durationMins to 1..120 itself
      allow write: if isUser()
        && changesOnly(['isIotEnabled', 'isSprinklerAuto', 'schedule', 'durationMins']);
    }
    match /sprinkler_state/{doc} {
      allow read: if signedIn();
      allow write: if signedIn();
    }
    match /sensor_memory/{doc} {
      allow read, write: if isUser();
    }

    // ---------------- derived results (never raw data)
    match /assessment_results/{id} {
      allow read: if ownsExisting();
      allow create: if ownsNew()
        && request.resource.data.origin == 'api'
        && request.resource.data.method in ['rule', 'statistical', 'rule+ML']
        && request.resource.data.keys().hasAll(['component', 'method', 'modelVersion', 'inputSummary',
                                                 'assessedAt', 'rawRef', 'userId']);
      allow update, delete: if false;           // results are append-only
    }
    match /sensor_corrections/{id} {
      allow read: if signedIn();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // everything else: denied
  }
}
